#include <winver.h>

// Exe icon (Explorer, Startup apps, Task Manager) and the name Windows shows in those lists.
1 ICON "zipshot.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Zipshot"
      VALUE "FileDescription", "Zipshot"
      VALUE "FileVersion", "1.3.0.0"
      VALUE "InternalName", "zipshot"
      VALUE "OriginalFilename", "zipshot.exe"
      VALUE "ProductName", "Zipshot"
      VALUE "ProductVersion", "1.3.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

// Sounds and Fugue icons taken from ShareX v18.0.1 (GPLv3; icons by Yusuke Kamiyamane, CC BY 3.0).

