  "narration_manifest": {
    "language": "ru",
    "voice": "Google Translate TTS through gTTS",
    "clips": [
      {
        "name": "intro",
        "text": "\u0421\u0440\u0430\u0432\u043d\u0438\u043c Zipshot \u0438 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 ShareX. \u0427\u0438\u0441\u0442\u0430\u044f Windows Sandbox, \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u043a\u043b\u0430\u0432\u0438\u0448\u0438 \u0438 \u043e\u0434\u043d\u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u041d\u0430\u0436\u0430\u0442\u0438\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0442\u0435\u0441\u0442\u043e\u0432\u044b\u0439 \u0441\u043a\u0440\u0438\u043f\u0442.",
        "duration_seconds": 13.416,
        "file": "intro.mp3"
      },
      {
        "name": "region",
        "text": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b \u043f\u0440\u0438\u043d\u0442\u0441\u043a\u0440\u0438\u043d. \u041d\u0430\u0436\u0430\u0442\u0438\u0435 \u0438 \u0442\u0430\u0439\u043c\u0435\u0440 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u044b \u043a \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u043c \u043c\u0435\u0442\u043a\u0430\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0417\u0434\u0435\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u043d \u043e\u0434\u0438\u043d \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u0438\u043c\u0435\u0440.",
        "duration_seconds": 10.56,
        "file": "region.mp3"
      },
      {
        "name": "png",
        "text": "\u0422\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u0438\u043d\u0442\u0441\u043a\u0440\u0438\u043d. \u0412\u043e \u0432\u0442\u043e\u0440\u043e\u043c \u0437\u0430\u043c\u0435\u0440\u0435 \u0436\u0434\u0451\u043c \u0433\u043e\u0442\u043e\u0432\u043e\u0433\u043e PNG. \u0424\u0430\u0439\u043b \u0434\u043e\u043b\u0436\u0435\u043d \u0437\u0430\u043a\u0440\u044b\u0442\u044c\u0441\u044f \u0438 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u0440\u043e\u0439\u0442\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f.",
        "duration_seconds": 10.728,
        "file": "png.mp3"
      },
      {
        "name": "arrow",
        "text": "\u041e\u0434\u043d\u0430 \u0441\u0442\u0440\u0435\u043b\u043a\u0430, \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u0430\u044f \u0442\u0440\u0430\u0435\u043a\u0442\u043e\u0440\u0438\u044f \u043a\u0443\u0440\u0441\u043e\u0440\u0430 \u0438 \u0434\u0432\u0435 \u0441\u0435\u043a\u0443\u043d\u0434\u044b \u043d\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.",
        "duration_seconds": 6.312,
        "file": "arrow.mp3"
      },
      {
        "name": "pencil",
        "text": "\u0422\u0435\u043f\u0435\u0440\u044c \u043a\u0430\u0440\u0430\u043d\u0434\u0430\u0448. \u0421\u043a\u0440\u0438\u043f\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0435 \u0441\u0442\u043e \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044c \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u043a\u0443\u0440\u0441\u043e\u0440\u0430. \u0421\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0435\u043c \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u043a\u0430\u0434\u0440\u044b \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u043e\u0432.",
        "duration_seconds": 10.008,
        "file": "pencil.mp3"
      },
      {
        "name": "tools",
        "text": "\u041e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435, \u043e\u0442\u043c\u0435\u043d\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u0441 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435\u043c. \u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u0440\u043e\u043b\u0438\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 \u043f\u043e\u043b\u043d\u043e\u043c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0438.",
        "duration_seconds": 10.896,
        "file": "tools.mp3"
      },
      {
        "name": "capture_data",
        "text": "\u0414\u043b\u044f \u0433\u0440\u0430\u0444\u0438\u043a\u043e\u0432 \u043d\u0430\u0436\u0430\u0442\u0438\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u044b \u043f\u043e \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044c \u0440\u0430\u0437. \u041c\u0435\u0434\u0438\u0430\u043d\u0430 \u0433\u043e\u0442\u043e\u0432\u043e\u0433\u043e PNG \u0443 Zipshot \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0442\u0440\u0438\u0441\u0442\u0430 \u0441\u043e\u0440\u043e\u043a \u043e\u0434\u043d\u0443 \u043c\u0438\u043b\u043b\u0438\u0441\u0435\u043a\u0443\u043d\u0434\u0443. \u0423 ShareX \u043f\u044f\u0442\u044c\u0441\u043e\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044c. \u042d\u0442\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0432 \u044d\u0442\u043e\u0439 \u0441\u0440\u0435\u0434\u0435.",
        "duration_seconds": 16.536,
        "file": "capture_data.mp3"
      },
      {
        "name": "recording",
        "text": "\u0417\u0430\u043f\u0438\u0441\u044c \u0442\u043e\u0436\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u0430. \u041a\u043b\u0438\u043f \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u0435\u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0430\u043d, \u0430 \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435 \u0438 \u0447\u0438\u0441\u043b\u043e \u043a\u0430\u0434\u0440\u043e\u0432 \u0441\u0432\u0435\u0440\u0435\u043d\u044b \u0441\u043e \u0441\u0447\u0451\u0442\u0447\u0438\u043a\u043e\u043c \u043d\u0430 \u0441\u0446\u0435\u043d\u0435.",
        "duration_seconds": 9.48,
        "file": "recording.mp3"
      },
      {
        "name": "resources",
        "text": "\u0420\u0430\u0441\u0445\u043e\u0434 \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043a\u043e\u0434\u0438\u0440\u043e\u0432\u0449\u0438\u043a\u0430 \u0438 \u043f\u0440\u0435\u0441\u0435\u0442\u0430. \u0423 Zipshot \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u043f\u0430\u043c\u044f\u0442\u0438 \u0432 \u044d\u0442\u043e\u043c \u0442\u0435\u0441\u0442\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u043b FFmpeg. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u044b \u043a \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e.",
        "duration_seconds": 16.8,
        "file": "resources.mp3"
      },
      {
        "name": "outro",
        "text": "\u041a\u043e\u0434, \u0440\u043e\u043b\u0438\u043a\u0438, \u0433\u0440\u0430\u0444\u0438\u043a\u0438 \u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u0437\u0430\u043c\u0435\u0440\u044b \u043b\u0435\u0436\u0430\u0442 \u043d\u0430 GitHub.",
